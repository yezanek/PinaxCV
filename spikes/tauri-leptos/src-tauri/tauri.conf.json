{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pinaxcv-spike",
  "version": "0.0.0",
  "identifier": "dev.pinaxcv.spike",
  "build": { "frontendDist": "../ui/dist" },
  "app": {
    "windows": [{ "title": "PinaxCV spike", "width": 900, "height": 1100 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' preview: http://preview.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"] }
}
