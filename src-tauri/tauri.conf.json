{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinaxCV",
  "version": "0.0.0",
  "identifier": "dev.pinaxcv.app",
  "build": {
    "frontendDist": "frontend-placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PinaxCV",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: preview: http://preview.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
