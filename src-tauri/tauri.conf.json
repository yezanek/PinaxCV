{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinaxCV",
  "identifier": "dev.pinaxcv.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PinaxCV",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: preview: http://preview.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Office",
    "shortDescription": "Local-first CV editor",
    "longDescription": "PinaxCV is a local-first CV editor: write one CV, tailor variants for each job, check them for applicant tracking systems and export PDF or HTML.",
    "copyright": "Copyright the PinaxCV authors. Apache-2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
