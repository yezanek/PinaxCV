{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call PinaxCV's own commands and nothing else. Dialogs run from Rust, so no dialog or fs permission is granted to the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-list-cvs",
    "allow-get-cv",
    "allow-create-cv",
    "allow-save-cv",
    "allow-duplicate-cv",
    "allow-delete-cv",
    "allow-restore-cv",
    "allow-list-variants",
    "allow-get-variant",
    "allow-create-variant",
    "allow-save-variant",
    "allow-delete-variant",
    "allow-duplicate-variant",
    "allow-prune-variant",
    "allow-fit-variant",
    "allow-ai-status",
    "allow-ai-configure",
    "allow-ai-forget-key",
    "allow-ai-consent",
    "allow-ai-test-connection",
    "allow-ai-cancel",
    "allow-ai-tailor",
    "allow-ai-review",
    "allow-ai-import",
    "allow-import-text-prepare",
    "allow-import-text-basic",
    "allow-get-review",
    "allow-review-decide",
    "allow-preview",
    "allow-export-pdf",
    "allow-export-html",
    "allow-ats-check",
    "allow-lint",
    "allow-list-templates",
    "allow-import-parse",
    "allow-import-match",
    "allow-import-commit",
    "allow-get-settings",
    "allow-set-cv-defaults",
    "allow-open-data-dir",
    "allow-backup-db",
    "allow-restore-db",
    "allow-clear-ai-cache",
    "allow-delete-all-data",
    "allow-third-party-licenses",
    "allow-photo-choose",
    "allow-photo-get",
    "allow-photo-apply",
    "allow-photo-remove",
    "allow-style-save",
    "allow-style-open",
    "allow-style-preview"
  ]
}
